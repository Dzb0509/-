# 复制为 .env 并填入你的密钥（密钥只进服务端，绝不打包进前端）
# 智谱 AI 开放平台：https://open.bigmodel.cn/

# ── 文本链路（点评 / Agent 对话 / 周报）──────────────────────
# 默认智谱；LLM_API_KEY 不填时自动回退读 ZHIPU_API_KEY
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=
NUXT_CHAT_MODEL=glm-4-flash

# ── 视觉链路（识餐，需要多模态模型）────────────────────────
# 识餐必须有视觉模型（DeepSeek 无视觉 API），默认智谱 GLM-4V-flash（免费）
ZHIPU_API_KEY=your_api_key_here
NUXT_VISION_MODEL=glm-4v-flash

# ── 向量化（RAG）──────────────────────────────────────────
# 仅智谱等提供 embeddings 接口的服务支持；无 embeddings 时自动降级关键词检索
NUXT_EMBEDDING_MODEL=embedding-3
